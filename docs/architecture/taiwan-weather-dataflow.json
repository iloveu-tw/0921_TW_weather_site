    { "id": "neonSnapshot", "type": "database", "label": "Neon PostgreSQL", "sublabel": "原子快照、同步紀錄與鎖", "stage": 3, "row": 1, "tag": "Transaction" },
    { "id": "webGisDashboard", "type": "frontend", "label": "Taiwan Weather GIS", "sublabel": "Leaflet 地圖與測站清單", "stage": 4, "row": 1, "tag": "876 Stations" },
